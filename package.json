  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@strands-agents/sdk": "^1.17.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
