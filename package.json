{
  "name": "proofline-strands",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A Strands-powered accountability agent for consequential business operations.",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
