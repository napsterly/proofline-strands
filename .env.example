PORT=8787
HOST=127.0.0.1
PUBLIC_BASE_URL=http://localhost:8787

# AWS Strands Agents / Amazon Bedrock
# Configure credentials with `aws configure`, IAM role, or a Bedrock API key.
AWS_REGION=us-west-2
AWS_BEARER_TOKEN_BEDROCK=
STRANDS_MODEL_ID=

# Slack app (Bot Token scopes: chat:write, reactions:read)
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=

# Stripe official Test Mode only (sk_test_...)
STRIPE_SECRET_KEY=

# Salesforce Developer Edition session
SALESFORCE_INSTANCE_URL=
SALESFORCE_ACCESS_TOKEN=
SALESFORCE_CLIENT_ID=
SALESFORCE_LOGIN_URL=https://login.salesforce.com
SALESFORCE_API_VERSION=v61.0
